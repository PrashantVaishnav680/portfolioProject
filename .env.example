# ============================================================
# Environment Variables Configuration
# ============================================================

# Port for local server (Render provides PORT automatically in production)
PORT=3000

# Resend API Key (Get yours from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender Email Address:
# - For testing without a verified custom domain, use Resend's default test address:
#   EMAIL_FROM=onboarding@resend.dev
#   (or with display name: EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>)
# - For production with your custom domain verified on Resend:
#   EMAIL_FROM=Portfolio Contact <contact@yourdomain.com>
EMAIL_FROM=onboarding@resend.dev

# Destination Email Address:
# The email address where contact form submissions will be delivered to you.
# IMPORTANT: When using "onboarding@resend.dev" as EMAIL_FROM, this MUST match
# the email address registered on your Resend account.
EMAIL_TO=your-email@example.com

# Allowed Frontend URL(s) for CORS protection:
# Enter your deployed Vercel URL here:
FRONTEND_URL=https://portfolio-project-sigma-steel.vercel.app
